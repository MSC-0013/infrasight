## Database Schema (PostgreSQL + Prisma)

### Core Tables

```prisma
model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  plan        Plan     @default(HOBBY)
  createdAt   DateTime @default(now())
  users       User[]
  events      Event[]
  // ... all other relations
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// TimescaleDB hypertable — partition by timestamp
model Event {
  id          String   @id @default(cuid())
  traceId     String?
  eventType   String
  status      EventStatus
  severity    Severity
  organization String
  queue       String
  worker      String
  latencyMs   Int
  retries     Int
  payload     Json
  timestamp   DateTime
  orgId       String
  @@index([orgId, timestamp(sort: Desc)])
  @@index([status, timestamp])
}

// TimescaleDB hypertable
model Span {
  spanId      String   @id
  traceId     String
  parentSpanId String?
  name        String
  service     String
  startTime   DateTime
  endTime     DateTime
  duration    Int      // ms
  status      SpanStatus
  tags        Json
  logs        Json
  @@index([traceId])
  @@index([service, startTime(sort: Desc)])
}

model LogEntry {
  id        String   @id @default(cuid())
  timestamp DateTime
  level     LogLevel
  service   String
  message   String
  traceId   String?
  spanId    String?
  fields    Json
  orgId     String
  @@index([orgId, timestamp(sort: Desc)])
  @@index([service, level])
}

model Queue {
  id          String   @id @default(cuid())
  name        String
  type        QueueType
  status      QueueStatus @default(HEALTHY)
  config      Json
  orgId       String
  createdAt   DateTime @default(now())
}

model Worker {
  id              String       @id @default(cuid())
  name            String
  status          WorkerStatus
  queue           String
  jobsProcessed   Int          @default(0)
  jobsFailed      Int          @default(0)
  cpuPercent      Float
  memMB           Float
  lastHeartbeat   DateTime
  orgId           String
}

model Incident {
  id          String         @id @default(cuid())
  title       String
  severity    IncidentSeverity
  status      IncidentStatus
  service     String
  description String?
  openedAt    DateTime       @default(now())
  resolvedAt  DateTime?
  assigneeId  String?
  orgId       String
  timeline    TimelineEntry[]
  postmortem  PostMortem?
}

model Alert {
  id          String      @id @default(cuid())
  name        String
  severity    AlertSeverity
  status      AlertStatus @default(OK)
  condition   Json
  threshold   Float
  service     String
  channels    Json
  cooldown    Int         @default(300) // seconds
  enabled     Boolean     @default(true)
  firedAt     DateTime?
  resolvedAt  DateTime?
  orgId       String
}

model Deployment {
  id          String           @id @default(cuid())
  service     String
  version     String
  environment String
  status      DeploymentStatus
  sha         String
  branch      String
  triggeredBy String
  startedAt   DateTime
  completedAt DateTime?
  rollback    Boolean          @default(false)
  orgId       String
}

model Slo {
  id          String    @id @default(cuid())
  name        String
  service     String
  target      Float     // e.g. 99.9
  window      String    // e.g. "30d"
  current     Float
  errorBudget Float
  burnRate    Float
  status      SloStatus
  orgId       String
}

model MlModel {
  id          String   @id @default(cuid())
  name        String
  version     String
  framework   String
  status      MlModelStatus
  orgId       String
  driftMetrics DriftMetric[]
}

model AuditEntry {
  id          String   @id @default(cuid())
  action      String
  actorId     String
  actorRole   String
  resource    String
  resourceId  String
  before      Json?
  after       Json?
  ip          String
  userAgent   String
  timestamp   DateTime @default(now())
  orgId       String
}

model AiInsight {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String
  severity    String
  service     String?
  rawResponse Json
  createdAt   DateTime @default(now())
  orgId       String
}
```


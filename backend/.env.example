# Copy to backend/.env — required for API

PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL (match docker-compose.yml)
DATABASE_URL=postgresql://pulse:pulse_secret@localhost:5432/pulse_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT — HS256 for local dev (min 32 chars)
JWT_SECRET=pulse-dev-jwt-secret-change-in-production-32chars

# Optional: RS256 in production
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# OpenAI (optional — AI RCA)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Email (optional)
RESEND_API_KEY=
EMAIL_FROM=noreply@pulse.io

# CORS — frontend dev server
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

ENABLE_AI=true
ENABLE_BULLMQ=true
ENABLE_WEBSOCKET=true
